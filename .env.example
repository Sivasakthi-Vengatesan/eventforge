# EventForge Environment Variables

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eventforge
# Fallback for zero-dependency local dev: sqlite+aiosqlite:///./eventforge.db

# Redis Streams
REDIS_URL=redis://localhost:6379/0

# Worker Settings
WORKER_COUNT=4
MAX_RETRIES=5
BASE_RETRY_DELAY_SEC=1.0

# Webhook Secrets
WEBHOOK_SECRET_STRIPE=whsec_stripe_test_secret_38472948
WEBHOOK_SECRET_RAZORPAY=rzp_sec_razorpay_test_98372184
WEBHOOK_SECRET_GITHUB=gh_sec_github_test_84729184
WEBHOOK_SECRET_GENERIC=gen_sec_generic_test_19284729

# Mock Fault Injection Defaults
MOCK_SUCCESS_RATE=0.90
MOCK_TIMEOUT_RATE=0.05
MOCK_SERVER_ERROR_RATE=0.05
